# Copy to .env and fill in: cp .env.example .env
# Values containing "$" (htpasswd hashes) must be single-quoted, otherwise
# Docker Compose expands "$apr1..." as a variable and the hash breaks.

#######################################
# Docker Compose
#######################################
# Prefixes the Docker network and volumes; DockerSpawner attaches user
# containers to "<COMPOSE_PROJECT_NAME>_default". Keep the value an existing
# deployment already uses - changing it creates new, empty Grafana/Prometheus volumes.
COMPOSE_PROJECT_NAME=mvre

# Public hostname. Also used for prometheus.<HOST>, grafana.<HOST>, traefik.<HOST>.
HOST=jupyter.example.org

#######################################
# JupyterHub
#######################################
# Helmholtz AAI OAuth client. Register the callback URL https://<HOST>/hub/oauth_callback
CLIENT_ID=changeme
CLIENT_SECRET=changeme

# Comma-separated JupyterHub admins, as their login emails (lowercase).
ADMIN_USERS=alice@example.org,bob@example.org

# Token for the "prometheus-service" JupyterHub service (read:metrics).
# Generate with: openssl rand -hex 32
API_TOKEN=changeme

#######################################
# Basic auth in front of Traefik-routed services
# htpasswd format, generate with: htpasswd -nb <user> <password>
# Multiple users: comma-separated
#######################################
# Used by the traefik.<HOST> route. Note: [web.auth.basic] in
# reverse-proxy/traefik.toml does not read this variable.
TRAEFIK_DASHBOARD_AUTH='admin:$apr1$changeme$changemechangemechangeme'
PROMETHEUS_AUTH='admin:$apr1$changeme$changemechangemechangeme'
GRAFANA_AUTH='admin:$apr1$changeme$changemechangemechangeme'

#######################################
# Grafana
#######################################
# Only applied when Grafana first creates its database; later changes are ignored.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# Paths inside the container; the host's /etc/certs is mounted at /etc/certs.
GRAFANA_CERT_FILE=/etc/certs/server.crt
GRAFANA_CERT_KEY=/etc/certs/server.key

#######################################
# Read by config files but NOT passed into the containers by
# docker-compose.yml, so setting them here currently has no effect.
#######################################
# jupyterhub_config.py; defaults to start-singleuser.sh
#DOCKER_SPAWN_CMD=start-singleuser.sh
# grafana/grafana.ini
#GRAFANA_SECRET_KEY=
#GRAFANA_PORT=3000
#GRAFANA_METRICS_USER=
#GRAFANA_METRICS_PASSWORD=
