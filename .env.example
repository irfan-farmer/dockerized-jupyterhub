# Copy to .env, fill in the required values, then restrict access: chmod 600 .env
# Commented lines are optional settings, shown with their defaults.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Public hostname of the hub. It needs a DNS record pointing to this host.
DOMAIN=

# Contact address for Let's Encrypt certificate notices.
ACME_EMAIL=

# OpenID Connect client. Register https://<DOMAIN>/hub/oauth_callback as the
# redirect URI. docs/configuration.md lists the URLs for common providers.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_AUTHORIZE_URL=
OAUTH_TOKEN_URL=
OAUTH_USERDATA_URL=

# Comma-separated usernames with admin rights. Admins can always log in.
ADMIN_USERS=

# Random values. The quick start in README.md fills all four with one command,
# or generate each one with: openssl rand -hex 32
METRICS_TOKEN=
PROXY_AUTH_TOKEN=
GRAFANA_SECRET_KEY=
GRAFANA_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Who may log in
# Only ADMIN_USERS can log in until you set at least one of these.
# ---------------------------------------------------------------------------

# ALLOWED_USERS=alice,bob
# ALLOWED_GROUPS=jupyter-users
# ADMIN_GROUPS=jupyter-admins
# Name of the claim that lists a user's groups.
# OAUTH_GROUPS_CLAIM=groups
# Allow everyone your identity provider authenticates.
# ALLOW_ALL_USERS=false

# ---------------------------------------------------------------------------
# Identity provider details
# ---------------------------------------------------------------------------

# OAUTH_USERNAME_CLAIM=preferred_username
# OAUTH_SCOPE=openid profile email
# Shown on the login button as "Sign in with ...".
# OAUTH_LOGIN_SERVICE=SSO

# ---------------------------------------------------------------------------
# User servers
# ---------------------------------------------------------------------------

# NOTEBOOK_IMAGE=quay.io/jupyter/scipy-notebook:2026-10-19
# USER_MEM_LIMIT=2G
# USER_CPU_LIMIT=1
# Seconds without activity before a user's server is stopped.
# IDLE_TIMEOUT=3600
# Host directory mounted read-only at ~/work/shared in every user server.
# SHARED_DATA_DIR=

# ---------------------------------------------------------------------------
# Certificates
# ---------------------------------------------------------------------------

# Use the Let's Encrypt staging CA while testing to avoid rate limits:
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
