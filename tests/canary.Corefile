# Test-only DNS resolver (see tests/compose.test.yaml). Logs every lookup.
# .invalid names never resolve, as RFC 6761 requires. Every other name gets
# 192.0.2.1, an address reserved for documentation, so nothing reaches a real
# server.
invalid {
    log
    template ANY ANY {
        rcode NXDOMAIN
    }
}

. {
    log
    template IN A {
        answer "{{ .Name }} 60 IN A 192.0.2.1"
    }
    template ANY ANY {
        rcode NOERROR
    }
}
