# Placeholder settings for tests/smoke-test.sh. Not for production.
DOMAIN=jupyterhub.test
ACME_EMAIL=admin@jupyterhub.test
# Unreachable on purpose: tests never request real certificates.
ACME_CA_SERVER=https://127.0.0.1:14000/dir
OAUTH_CLIENT_ID=test
OAUTH_CLIENT_SECRET=test
OAUTH_AUTHORIZE_URL=https://idp.jupyterhub.test/authorize
OAUTH_TOKEN_URL=https://idp.jupyterhub.test/token
OAUTH_USERDATA_URL=https://idp.jupyterhub.test/userinfo
ADMIN_USERS=admin
METRICS_TOKEN=test-metrics-token
PROXY_AUTH_TOKEN=test-proxy-token
GRAFANA_SECRET_KEY=test-secret-key
GRAFANA_ADMIN_PASSWORD=test-admin-password
